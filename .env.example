# Public browser variables
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only variables — never prefix these with NEXT_PUBLIC_
PRIVY_APP_SECRET=
BLOB_READ_WRITE_TOKEN=
# JSON array of exactly 64 integers (0-255) — the same format as
# ~/.config/solana/id.json (solana-keygen's 64-byte secret key: private key
# + public key bytes). Generate one with:
#   solana-keygen new --no-bip39-passphrase -o /tmp/fee-payer.json
#   cat /tmp/fee-payer.json
# Fund the resulting pubkey with devnet SOL before using it as a fee payer.
FEE_PAYER_SECRET_KEY=

# Privy dashboard -> Wallet infrastructure -> Authorization keys -> Create new key
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_KEY=
# Test deposit token, created by scripts/setup-devnet.ts
NEXT_PUBLIC_DEPOSIT_MINT=
# Seconds after lease end before the tenant may claim the deposit (demo: short)
RETURN_TIMEOUT_SECONDS=120
# Privy policy id from scripts/privy-policy.ts
NEXT_PUBLIC_PRIVY_POLICY_ID=
